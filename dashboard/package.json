{
  "name": "analytics-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-i18n.mjs",
    "build": "pnpm build:app && pnpm build:tracker",
    "build:app": "vite build",
    "build:tracker": "vite build --config vite.tracker.config.ts",
    "deploy": "pnpm build && bash ../sync.sh",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "6.6.0",
    "@lingui/format-po": "6.6.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "daisyui": "^5.7.9",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
